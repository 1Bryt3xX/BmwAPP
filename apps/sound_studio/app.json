        ["studio", "B&W Studio (Pure Mastering)"],
        ["concert", "Concert Hall (Live Immersion)"],
        ["stage", "On Stage (Front Clarity)"],
        ["club", "Club & Bass Boost (Sub Punch)"],
        ["cinema", "Cinema 3D (Dynamic Surround)"],
        ["lounge", "Acoustic Lounge (Soft Travel)"]
      ]
    },
    {
      "key": "surround3d",
      "label": "3D Immersion surround level",
      "type": "choice",
      "default": "mid",
      "options": [
        ["off", "Off (Pure Stereo Audiophile)"],
        ["low", "Low (Subtle Depth)"],
        ["mid", "Medium (Balanced Staging)"],
        ["high", "High (Full 3D Dome)"]
      ]
    },
    {
      "key": "loudnessComp",
      "label": "Dynamic loudness (bass boost at low vol)",
      "type": "bool",
      "default": true
