    {
      "key": "speedVolume",
      "label": "Speed-dependent volume (GAL)",
      "type": "choice",
      "default": "3",
      "options": [
        ["off", "Off"],
        ["1", "Level 1 (Subtle)"],
        ["3", "Level 3 (Adaptive Default)"],
        ["5", "Level 5 (Highway Max)"]
