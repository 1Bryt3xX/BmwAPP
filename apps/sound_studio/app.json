    },
    {
      "key": "asdMode",
      "label": "Active Sound Design (engine in speakers)",
      "type": "choice",
      "default": "oem",
      "options": [
        ["oem", "OEM Default (Follows driving mode)"],
        ["reduced", "Reduced (Quiet cabin)"],
        ["off", "Muted (Pure music without engine noise)"],
        ["sport", "Sport+ Enhanced (Throaty exhaust sound)"]
