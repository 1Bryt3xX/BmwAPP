    },
    {
      "key": "theme",
      "label": "Colour theme",
      "type": "choice",
      "default": "m_tricolour",
      "options": [
        ["m_tricolour", "M Tricolour"],
        ["m_red", "M Red"],
        ["ice", "Ice White"],
        ["amber", "Night Amber"]
