        ["hk", "Harman Kardon Logic 7"],
        ["hifi", "BMW Hi-Fi System (205 W)"],
        ["base", "Standard Stereo System"]
      ]
    },
    {
      "key": "defaultProfile",
      "label": "Default sound profile",
      "type": "choice",
      "default": "studio",
