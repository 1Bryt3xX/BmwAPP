{
  "id": "sound_studio",
  "title": "Sound Studio",
  "description": "Professional Audio DSP, Multi-Band Equalizer, Speaker Staging and Surround Profiles (Harman Kardon, Bowers & Wilkins, RAM) for BMW iDrive 7.",
  "version": "1.0.0",
  "vendor": "custom",
  "loggingId": "OAA6",
  "iconGlyph": "sound_studio",
  "signals": {
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "statusCarSpeed2": "rs"
    },
    "de.bmw.infotainment.controlelements.FrontCCU": {
      "statusRotaryEncoderState": "rs",
      "statusPushButtonsState": "rs"
    },
    "de.bmw.infotainment.drivingexcitement.FES": {
      "_optional": "follow driving modes",
      "statusFESVehicleDynamicSwitchHMI": "rs"
    },
    "com.harman.infotainment.systemfunctions.tasu.tasu.InternalTasu": {
      "_instances": "SystemFunctionsInternalTasuInst1",
      "_methods": [
        "sendTasuRequest"
      ],
      "_broadcasts": [
        "sendTasuResponse"
      ]
    }
  },
  "screens": [
    {
      "name": "MAIN",
      "kind": "canvas",
      "title": "Sound Studio",
      "buttons": [
        ["BTN_PRESET", "Next Preset"],
        ["BTN_PAGE", "Next Tab"],
        ["BTN_PREV", "Prev Tab"],
        ["BTN_SETTINGS", "Settings"]
      ]
    }
  ],
  "settings": [
    {
